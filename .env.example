# Compose image defaults
IMAGE_REPO=ghcr.io/mayvqt/veil
IMAGE_TAG=latest
CONTAINER_NAME=veil

# Unraid/container runtime defaults
PUID=99
PGID=100
TZ=UTC
UMASK=022

# App paths/ports
VEIL_CONFIG_PATH=./data
VEIL_DATA_DIR=/config
DATABASE_PATH=/config/veil.db
APP_BIND_ADDR=:3847

# Required at runtime (set a long random value in your local .env or Unraid app env vars)
SESSION_SECRET=

# Cookies / origin
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=720
PUBLIC_ORIGIN=
APP_ENV=production

# Optional retention policy
MESSAGE_RETENTION_DAYS=
MESSAGE_RETENTION_COUNT=

# Reverse-proxy deployment recommendation:
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://veil.example.com
