# Local dev defaults
APP_BIND_ADDR=:3847
DATABASE_PATH=/data/veil.db
SESSION_SECRET=change-this-for-dev
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=720
PUBLIC_ORIGIN=

# Reverse-proxy deployment recommendation:
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://veil.example.com
# VEIL_BASE is for TUI clients, for example:
# VEIL_BASE=https://veil.example.com
