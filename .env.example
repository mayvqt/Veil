# Veil env template for docker-compose / container runtime
# Copy to `.env`. Defaults are dev-friendly for local docker compose.
# For production, set SESSION_SECRET and APP_ENV=production.

# ---------- Image / Container ----------
IMAGE_REPO=ghcr.io/mayvqt/veil
IMAGE_TAG=latest
CONTAINER_NAME=veil

# ---------- Runtime User / Locale ----------
PUID=99
PGID=100
TZ=UTC
UMASK=022

# ---------- Paths / Network ----------
VEIL_CONFIG_PATH=./data
VEIL_DATA_DIR=/config
DATABASE_PATH=/config/veil.db
APP_BIND_ADDR=:3847

# Optional explicit storage overrides (otherwise derived from VEIL_DATA_DIR)
# AVATAR_DIR=/config/avatars
# MEDIA_DIR=/config/media

# ---------- Production Required ----------
# Set to a long random string before production deployments.
SESSION_SECRET=

# ---------- App / Session ----------
APP_ENV=dev
ALLOW_INSECURE_DEFAULT_SECRET=true
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=720
PUBLIC_ORIGIN=

# ---------- Optional Retention ----------
MESSAGE_RETENTION_DAYS=
MESSAGE_RETENTION_COUNT=

# ---------- Reverse Proxy Example ----------
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://veil.example.com
